{
  "mode": "peer",
  "listen": {
    "endpoints": [
      "tcp/10.42.0.2:7447"
    ]
  },
  "scouting": {
    "multicast": {
      "enabled": false
    }
  },
  "plugins": {
    "ros2dds": {
      "domain": 5,
      "ros_automatic_discovery_range": "LOCALHOST",
      "allow": {
        "publishers": [
          "/odom",
          "/odometry/filtered/global",
          "/odometry/filtered/local",
          "/tf",
          "/tf_static",
          "/livox/imu",
          "/mission/status",
          "/task/plan",
          "/docking/berth1_nominal",
          "/docking/berth2_nominal",
          "/task1/safety_points",
          "/task2/safety_points",
          "/task2/points_filtered_visual",
          "/task2/self_vessel_marker",
          "/tracked_objects/markers",
          "/mppi/crm_costmap",
          "/planned_path_pruned",
          "/docking/berth1_corrected",
          "/docking/berth2_corrected",
          "/autonomy/ready",
          "/heartbeat/autonomy",
          "/task2/buoy_pose_correction",
          "/other_ship/twist",
          "/task2/opponent_detected",
          "/task2/selected_opponent_marker",
          "/task2/selected_opponent_velocity_marker",
          "/waypoint1_pose",
          "/waypoint2_pose",
          "/buoy_detections",
          "/buoy_detections_3d",
          "/virtual_obstacles",
          "/buoy_roi",
          "/diagnostics",
          "/zed2i/left/preview/q40/compressed",
          "/yolo/debug_preview/q40/compressed",
          "/zed2i/yolo/debug_image",
          "/zed2i/debug/detections_image",
          "/heartbeat/driver/camera/front",
          "/heartbeat/driver/lidar",
          "/joy/set_feedback",
          "/foxglove_log",
          "/sensor/vehicle_gnss/fix/raw",
          "/sensor/vehicle_gnss/compass/raw",
          "/gui/ground_speed_mps",
          "/mission/waypoint_markers",
          "/actual_path_marker",
          "/local_costmap/costmap",
          "/cmd_vel_markers",
          "/gui/battery_percent",
          "/gui/livox/points",
          "/task1/safety_points_visual",
          "/agx/rosbag/recording_status"
        ],
        "subscribers": [
          "/runtime_parameter_updates"
        ],
        "service_servers": [
          "/mission/list_tasks",
          "/mission/get_status",
          "/mission/start_task",
          "/mission/stop_task",
          "/control/set_mode",
          "/agx/rosbag/set_recording"
        ],
        "service_clients": [],
        "action_servers": [
          "/mission/run_task"
        ],
        "action_clients": []
      },
      "transient_local_cache_multiplier": 20,
      "queries_timeout": {
        "transient_local_subscribers": 10.0
      }
    }
  }
}
