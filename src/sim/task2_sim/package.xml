<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>task2_sim</name>
  <version>0.1.0</version>
  <description>Task2 simulation orchestrator with moving red/green buoy TF and goal monitoring.</description>
  <maintainer email="oswystk15662@keio.jp">osw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>launch_ros</depend>

  <exec_depend>asv_trajectory_planner</exec_depend>
  <exec_depend>tf_frame_arrow_publisher</exec_depend>
  <exec_depend>robot</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sensor_sim_with_noise</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
