<?xml version="1.0"?>
<package format="3">
  <name>runtime_manager</name><version>0.1.0</version>
  <description>Own and replace the selected Nav2 runtime process</description>
  <maintainer email="oswystk15662@keio.jp">NJORD</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
