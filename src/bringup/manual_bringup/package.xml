<?xml version="1.0"?>
<package format="3">
  <name>manual_bringup</name><version>0.1.0</version>
  <description>Compose the legacy real-vessel manual hardware bringup</description>
  <maintainer email="oswystk15662@keio.jp">NJORD</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot</exec_depend>
  <exec_depend>joystick_control</exec_depend>
  <exec_depend>legacy_command_mux</exec_depend>
  <exec_depend>micon_driver_fd</exec_depend>
  <exec_depend>bms</exec_depend>
  <exec_depend>thruster_controller</exec_depend>
  <exec_depend>um982_driver</exec_depend>
  <exec_depend>um982_feedback_filter</exec_depend>
  <exec_depend>tf_frame_arrow_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>diagnostic_monitors</exec_depend>
  <exec_depend>pcl_det</exec_depend>
  <exec_depend condition="$NJORD_ENABLE_GPU_SENSORS == 1">livox_ros_driver2</exec_depend>
  <exec_depend condition="$NJORD_ENABLE_GPU_SENSORS == 1">zed2i_driver</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
