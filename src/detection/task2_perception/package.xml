<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>task2_perception</name>
  <version>0.1.0</version>
  <description>
    Task 2 LiDAR perception glue: cloud filtering for the pcl_segmentation
    pipeline and opponent-ship selection for the MPPI planner.
  </description>
  <maintainer email="pigleteshima@gmail.com">IBO-ASV</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>launch_ros</depend>

  <exec_depend>python3-numpy</exec_depend>
  <!-- ship_perception_msgs is provided by the pcl_segmentation submodule -->
  <exec_depend>ship_perception_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
