<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simple_manual</name>
  <version>0.0.0</version>
  <description>Joystick conversion and X4 manual thrust allocation.</description>
  <maintainer email="oswystk15662@keio.jp">osw</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>njord_platform</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>diagnostic_monitors</exec_depend>
  <exec_depend>drogger_wired_flex</exec_depend>
  <exec_depend condition="$NJORD_ENABLE_GPU_SENSORS == 1">glim_ros</exec_depend>
  <exec_depend condition="$NJORD_ENABLE_GPU_SENSORS == 1">livox_ros_driver2</exec_depend>
  <exec_depend>micon_driver_fd</exec_depend>
  <exec_depend>pcl_det</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>thruster_driver</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>um982_driver</exec_depend>
  <exec_depend>um982_feedback_filter</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend condition="$NJORD_ENABLE_GPU_SENSORS == 1">zed2i_driver</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
