<?xml version="1.0"?>
<robot name="njord_asv" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="base_width" value="1.0" />
  <xacro:property name="base_length" value="1.5" />
  <xacro:property name="base_height" value="0.5" />

  <xacro:property name="lidar_x" value="0.5" />
  <xacro:property name="lidar_y" value="0.0" />
  <xacro:property name="lidar_z" value="0.8" />
  <!--
    NOMINAL 180-deg roll for upside-down Mid360 mounting - MEASURE and update
    before trusting perception/GLIM; this URDF is the ONLY inversion
    correction point; do not re-rotate in nodes. Perception nodes must simply
    transform livox_frame -> base_link via TF.
  -->
  <xacro:property name="lidar_roll" value="3.14159265358979" />
  <xacro:property name="lidar_pitch" value="0" />
  <xacro:property name="lidar_yaw" value="0" />

  <xacro:property name="imu_x" value="0.0" />
  <xacro:property name="imu_y" value="0.0" />
  <xacro:property name="imu_z" value="0.2" />

  <xacro:property name="gnss1_x" value="-0.5" />
  <xacro:property name="gnss1_y" value="0.4" />
  <xacro:property name="gnss1_z" value="1.0" />

  <xacro:property name="gnss2_x" value="0.5" />
  <xacro:property name="gnss2_y" value="-0.4" />
  <xacro:property name="gnss2_z" value="1.0" />

  <xacro:property name="thruster_front_x" value="0.1803" />
  <xacro:property name="thruster_rear_x" value="-0.1803" />
  <xacro:property name="thruster_right_y" value="-0.2500" />
  <xacro:property name="thruster_left_y" value="0.2500" />
  <xacro:property name="thruster_z" value="-0.1" />

  <xacro:macro name="thruster_link" params="name x y z">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.04" length="0.16"/>
        </geometry>
        <material name="black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>


  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 0.8"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ZED2i left camera optical-origin frame, rigidly mounted at the bow. -->
  <link name="zed2i_left_camera_frame"/>

  <joint name="zed2i_left_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed2i_left_camera_frame"/>
    <origin xyz="0.48 0 0.47" rpy="0 0 0"/>
  </joint>

  <!-- The right imager is 15 cm to starboard of the left imager. -->
  <link name="zed2i_right_camera_frame"/>

  <joint name="zed2i_right_camera_joint" type="fixed">
    <parent link="zed2i_left_camera_frame"/>
    <child link="zed2i_right_camera_frame"/>
    <origin xyz="0 -0.15 0" rpy="0 0 0"/>
  </joint>

  <!-- Rear camera: 60 cm aft of the ZED2i stereo centre, facing aft.
       Relative to the left imager, the stereo centre is 7.5 cm starboard. -->
  <link name="back_cam_link"/>

  <joint name="back_cam_joint" type="fixed">
    <parent link="zed2i_left_camera_frame"/>
    <child link="back_cam_link"/>
    <origin xyz="-0.60 -0.075 0" rpy="0 0 3.141592653589793"/>
  </joint>

  <link name="livox_frame">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="${lidar_roll} ${lidar_pitch} ${lidar_yaw}"/>
    <!-- The MID-360 is mounted upside down: preserve its origin while
         rotating its frame 180 degrees around the vehicle X axis. -->
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="3.141592653589793 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <!-- Placeholder Spatial extrinsics. Measure and replace before tuning fusion. -->
  <link name="spatial_link"/>

  <joint name="spatial_joint" type="fixed">
    <parent link="base_link"/>
    <child link="spatial_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gnss_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="gnss_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_link"/>
    <origin xyz="${gnss1_x} ${gnss1_y} ${gnss1_z}" rpy="0 0 0"/>
  </joint>

  <link name="gnss_sub_link">
     <visual>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="gnss_sub_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_sub_link"/>
    <origin xyz="${gnss2_x} ${gnss2_y} ${gnss2_z}" rpy="0 0 0"/>
  </joint>

  <xacro:thruster_link name="thruster_FR" x="${thruster_front_x}" y="${thruster_right_y}" z="${thruster_z}"/>
  <xacro:thruster_link name="thruster_FL" x="${thruster_front_x}" y="${thruster_left_y}" z="${thruster_z}"/>
  <xacro:thruster_link name="thruster_RR" x="${thruster_rear_x}" y="${thruster_right_y}" z="${thruster_z}"/>
  <xacro:thruster_link name="thruster_RL" x="${thruster_rear_x}" y="${thruster_left_y}" z="${thruster_z}"/>

</robot>
