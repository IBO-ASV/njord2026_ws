<robot name="njord_asv">
	<link name="base_link">
		<visual>
			<geometry>
				<box size="1.5 1.0 0.5"/>
			</geometry>
			<material name="blue">
				<color rgba="0.0 0.0 1.0 0.8"/>
			</material>
		</visual>
		<collision>
			<geometry>
				<box size="1.5 1.0 0.5"/>
			</geometry>
		</collision>
		<inertial>
			<mass value="1."/>
			<inertia ixx="1." ixy="0." ixz="0." iyx="0." iyy="1." iyz="0." izx="0." izy="0." izz="1."/>
		</inertial>
	</link>
	<link name="livox_frame">
		<visual>
			<geometry>
				<cylinder length="0.1" radius="0.05"/>
			</geometry>
			<material name="black">
				<color rgba="0.0 0.0 0.0 1.0"/>
			</material>
		</visual>
		<inertial>
			<mass value="1."/>
			<inertia ixx="1." ixy="0." ixz="0." iyx="0." iyy="1." iyz="0." izx="0." izy="0." izz="1."/>
		</inertial>
	</link>
	<joint name="lidar_joint" type="fixed">
		<parent link="base_link"/>
		<child link="livox_frame"/>
		<!-- The MID-360 is mounted upside down: 180 degrees about X. -->
		<origin rpy="3.141592653589793 0 0" xyz="0.5 0.0 0.8"/>
	</joint>
	<link name="imu_link">
		<visual>
			<geometry>
				<box size="0.05 0.05 0.02"/>
			</geometry>
			<material name="orange">
				<color rgba="1.0 0.5 0.0 1.0"/>
			</material>
		</visual>
		<inertial>
			<mass value="1."/>
			<inertia ixx="1." ixy="0." ixz="0." iyx="0." iyy="1." iyz="0." izx="0." izy="0." izz="1."/>
		</inertial>
	</link>
	<joint name="imu_joint" type="fixed">
		<parent link="base_link"/>
		<child link="imu_link"/>
		<origin rpy="0 0 0" xyz="0.0 0.0 0.2"/>
	</joint>
	<link name="gnss_link">
		<visual>
			<geometry>
				<cylinder length="0.05" radius="0.08"/>
			</geometry>
			<material name="white">
				<color rgba="1.0 1.0 1.0 1.0"/>
			</material>
		</visual>
		<inertial>
			<mass value="1."/>
			<inertia ixx="1." ixy="0." ixz="0." iyx="0." iyy="1." iyz="0." izx="0." izy="0." izz="1."/>
		</inertial>
	</link>
	<joint name="gnss_joint" type="fixed">
		<parent link="base_link"/>
		<child link="gnss_link"/>
		<origin rpy="0 0 0" xyz="-0.5 0.4 1.0"/>
	</joint>
	<link name="gnss_sub_link">
		<visual>
			<geometry>
				<cylinder length="0.05" radius="0.08"/>
			</geometry>
			<material name="white"/>
		</visual>
		<inertial>
			<mass value="1."/>
			<inertia ixx="1." ixy="0." ixz="0." iyx="0." iyy="1." iyz="0." izx="0." izy="0." izz="1."/>
		</inertial>
	</link>
	<joint name="gnss_sub_joint" type="fixed">
		<parent link="base_link"/>
		<child link="gnss_sub_link"/>
		<origin rpy="0 0 0" xyz="-0.5 -0.4 1.0"/>
	</joint>
	<link name="thruster_FR">
		<visual>
			<geometry>
				<cylinder length="0.16" radius="0.04"/>
			</geometry>
			<material name="black"/>
		</visual>
	</link>
	<joint name="thruster_FR_joint" type="fixed">
		<parent link="base_link"/>
		<child link="thruster_FR"/>
		<origin rpy="0 0 0" xyz="0.1803 -0.2500 -0.1"/>
	</joint>
	<link name="thruster_FL">
		<visual>
			<geometry>
				<cylinder length="0.16" radius="0.04"/>
			</geometry>
			<material name="black"/>
		</visual>
	</link>
	<joint name="thruster_FL_joint" type="fixed">
		<parent link="base_link"/>
		<child link="thruster_FL"/>
		<origin rpy="0 0 0" xyz="0.1803 0.2500 -0.1"/>
	</joint>
	<link name="thruster_RR">
		<visual>
			<geometry>
				<cylinder length="0.16" radius="0.04"/>
			</geometry>
			<material name="black"/>
		</visual>
	</link>
	<joint name="thruster_RR_joint" type="fixed">
		<parent link="base_link"/>
		<child link="thruster_RR"/>
		<origin rpy="0 0 0" xyz="-0.1803 -0.2500 -0.1"/>
	</joint>
	<link name="thruster_RL">
		<visual>
			<geometry>
				<cylinder length="0.16" radius="0.04"/>
			</geometry>
			<material name="black"/>
		</visual>
	</link>
	<joint name="thruster_RL_joint" type="fixed">
		<parent link="base_link"/>
		<child link="thruster_RL"/>
		<origin rpy="0 0 0" xyz="-0.1803 0.2500 -0.1"/>
	</joint>
</robot>
