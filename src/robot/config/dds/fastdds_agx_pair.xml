<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for direct AGX <-> ground Jetson ROS 2 communication.
  Configure each machine's Tailscale addresses through the launch arguments.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>njord_tailscale_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>${NJORD_FASTDDS_LOCAL_IP}</address>
        </interfaceWhiteList>
        <maxInitialPeersRange>120</maxInitialPeersRange>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="njord_agx_pair" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>njord_tailscale_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
        <builtin>
          <avoid_builtin_multicast>true</avoid_builtin_multicast>
          <initialPeersList>
            <!-- Include this host so local ROS nodes can discover one another. -->
            <locator>
              <udpv4>
                <address>${NJORD_FASTDDS_LOCAL_IP}</address>
              </udpv4>
            </locator>
            <locator>
              <udpv4>
                <address>${NJORD_FASTDDS_PEER_IP}</address>
              </udpv4>
            </locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>
